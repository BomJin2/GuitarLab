{
  "name": "guitarlab",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.14.3",
  "engines": {
    "node": ">=20.9.0 <21 || >=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:app": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm format:check && cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --locked --manifest-path src-tauri/Cargo.toml -- -D warnings && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@coderline/alphatab": "1.6.1",
    "@tauri-apps/api": "2.12.3",
    "fflate": "0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "6.4.4",
    "vitest": "3.2.4"
  }
}
