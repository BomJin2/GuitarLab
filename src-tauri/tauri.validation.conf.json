{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GuitarLab Validation",
  "mainBinaryName": "guitarlab-validation",
  "identifier": "com.guitarlab.validation",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GuitarLab · 설치 검증",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../docs/release/": "third-party/",
      "../docs/19-BACKUP-AND-RECOVERY.md": "BACKUP-README.ko.md"
    },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false,
        "compression": "zlib"
      }
    }
  }
}
